generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL")
}

enum PackageType {
    REGULAR
    SPECIAL
}

enum PackageOccasion {
    NONE
    CHRISTMAS
    DIWALI
    NEW_YEAR
    VALENTINE
    HOLI
    EID
    SUMMER
    WINTER
    FESTIVAL
    OTHER
}

enum OfferType {
    EARLY_BIRD
    FLASH_SALE
    SEASONAL
    FESTIVE
    LIMITED_TIME
    SPECIAL
}

model Package {
    id          String  @id @default(auto()) @map("_id") @db.ObjectId
    name        String
    slug        String  @unique
    category    String

    type     PackageType     @default(REGULAR)
    occasion PackageOccasion @default(NONE)

    subtitle    String?
    description String?

    location  String?
    latitude  Float?
    longitude Float?

    duration  String?
    groupSize String?

    idealTrip       String?
    budget          String?
    bestTimeToVisit String?

    originalPrice Float?
    offerPrice    Float?
    discount      Float?
    saveAmount    Float?

    validTill DateTime?

    rating       Float?
    reviewsCount Int?

    highlights String[]
    inclusions String[]
    exclusions String[]

    whyVisitTitle       String?
    whyVisitDescription String?
    whyVisitHighlights  String[]

    heroImage String?
    gallery   PackageImage[]

    itinerary ItineraryDay[]

    metaTitle       String?
    metaDescription String?
    keywords        String[]

    isPublished Boolean @default(false)
    isFeatured Boolean @default(false)

    publishedAt DateTime?

    offers Offer[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

type PackageImage {
    url      String
    publicId String
}

type ItineraryDay {
    day         Int
    title       String
    description String?
    activities  String[]
    meals       String[]
    overnight   String?
}

model Offer {
    id String @id @default(auto()) @map("_id") @db.ObjectId

    title String
    slug  String @unique

    type OfferType

    description String?

    packageId String  @db.ObjectId
    package   Package @relation(fields: [packageId], references: [id])

    originalPrice Float?
    offerPrice    Float
    discount      Float?
    saveAmount    Float?

    startDate DateTime
    endDate   DateTime

    isActive   Boolean @default(true)
    isFeatured Boolean @default(false)

    badgeText String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}